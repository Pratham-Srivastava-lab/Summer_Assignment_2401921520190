class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        int windowSum = 0;

        for (int i = 0; i < k; i++)
            windowSum += nums[i];

        int bestSum = windowSum;

        for (int i = k; i < nums.size(); i++) {
            windowSum += nums[i] - nums[i - k];  // add right, drop left
            bestSum = max(bestSum, windowSum);
        }

        return (double)bestSum / k;
    }
};
