class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        int k = 0;

        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] != 0)
                nums[k++] = nums[i];   // compact non-zeroes to the front
        }

        while (k < nums.size())
            nums[k++] = 0;             // fill remainder with zeroes
    }
};
