class Solution {
public:
    int diagonalSum(vector<vector<int>>& mat) {
        int n   = mat.size();
        int sum = 0;

        for (int i = 0; i < n; i++) {
            sum += mat[i][i];           // primary:   (0,0) (1,1) (2,2)
            sum += mat[i][n - 1 - i];  // secondary: (0,2) (1,1) (2,0)
        }

        if (n % 2 == 1)
            sum -= mat[n / 2][n / 2];  // center counted twice, remove once

        return sum;
    }
};
