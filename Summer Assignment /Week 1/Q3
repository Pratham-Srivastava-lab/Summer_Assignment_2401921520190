class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int minPrice = INT_MAX;
        int maxProfit = 0;

        for (int price : prices) {
            if (price < minPrice) {
                minPrice = price;          // found a cheaper buy day
            } else {
                maxProfit = max(maxProfit, price - minPrice);  // best sell today?
            }
        }

        return maxProfit;
    }
};
