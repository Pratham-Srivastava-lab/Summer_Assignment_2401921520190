class Solution {
public:
    string reverseWords(string s) {
        int start = 0;

        for (int i = 0; i <= s.length(); i++) {
            if (i == s.length() || s[i] == ' ') {
                // reverse [start, i-1] in place
                int left = start, right = i - 1;
                while (left < right)
                    swap(s[left++], s[right--]);

                start = i + 1;  // next word starts after the space
            }
        }

        return s;
    }
};
