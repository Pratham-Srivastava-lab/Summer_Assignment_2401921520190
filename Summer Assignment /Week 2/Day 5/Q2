class Solution {
public:
    int compress(vector<char>& chars) {
        int write = 0;
        int read  = 0;
        int n     = chars.size();

        while (read < n) {
            char cur   = chars[read];
            int  count = 0;

            // count the full run
            while (read < n && chars[read] == cur) {
                read++;
                count++;
            }

            // write the character
            chars[write++] = cur;

            // write the count (skip if 1)
            if (count > 1) {
                string cnt = to_string(count);
                for (char c : cnt)
                    chars[write++] = c;
            }
        }

        return write;
    }
};
