class MinStack {
    stack<int> st;
    stack<int> minSt;  // top always holds current minimum

public:
    MinStack() {}

    void push(int val) {
        st.push(val);
        int curMin = minSt.empty() ? val : min(val, minSt.top());
        minSt.push(curMin);
    }

    void pop() {
        st.pop();
        minSt.pop();
    }

    int top() {
        return st.top();
    }

    int getMin() {
        return minSt.top();
    }
};
