class Solution {
public:
    int largestRectangleArea(vector<int>& heights) {
        stack<int> st;
        int best = 0;
        int n    = heights.size();

        for (int i = 0; i <= n; i++) {
            int curH = (i == n) ? 0 : heights[i];

            while (!st.empty() && heights[st.top()] > curH) {
                int h     = heights[st.top()]; st.pop();
                int width = st.empty() ? i : i - st.top() - 1;
                best      = max(best, h * width);
            }

            st.push(i);
        }

        return best;
    }
};
